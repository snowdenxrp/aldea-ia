{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexo.invalid/schema/safety-claim-dependency-closure-1",
  "title": "Nexo Safety Claim Dependency Closure",
  "type": "object",
  "required": [
    "claim_id","protected_function","assurance_level",
    "components","dependencies","failure_domains",
    "trust_roots","authority_domains","policy_version",
    "invariant_version","dependency_graph_version",
    "unknown_dependency_policy","review"
  ],
  "properties": {
    "claim_id": {"type":"string","minLength":1},
    "protected_function": {"type":"string","minLength":1},
    "assurance_level": {"enum":["I0","I1","I2","I3","I4","I5"]},
    "components": {
      "type":"array","items":{"type":"object","required":["component_id","role","dependency_refs"],
        "properties":{
          "component_id":{"type":"string"},
          "role":{"type":"string"},
          "dependency_refs":{"type":"array","items":{"type":"string"}},
          "artifact_digest":{"type":["string","null"]},
          "config_digest":{"type":["string","null"]},
          "runtime_identity":{"type":["string","null"]}
        }
      }
    },
    "dependencies": {
      "type":"array","items":{"type":"object","required":["dependency_id","domain","state"],
        "properties":{
          "dependency_id":{"type":"string"},
          "domain":{"enum":["hardware","host","kernel","hypervisor","runtime","storage","network","dns","clock","identity","credential","kms","trust_root","policy","configuration","artifact","builder","package","model_provider","data_source","operator","admin","observability","coordination","recovery","schema_semantics"]},
          "state":{"enum":["KNOWN","UNKNOWN","COMPROMISED","STALE","INVALIDATED"]},
          "failure_domain":{"type":"string"},
          "owner":{"type":["string","null"]}
        }
      }
    },
    "failure_domains": {
      "type":"array","items":{"type":"object","required":["domain_id","members"],
        "properties":{
          "domain_id":{"type":"string"},
          "members":{"type":"array","items":{"type":"string"}},
          "independence_group":{"type":["string","null"]}
        }
      }
    },
    "trust_roots":{"type":"array","items":{"type":"string"}},
    "authority_domains":{"type":"array","items":{"type":"string"}},
    "policy_version":{"type":"string"},
    "invariant_version":{"type":"string"},
    "dependency_graph_version":{"type":"string"},
    "unknown_dependency_policy":{"enum":["BLOCK","RESTRICT","HOLD","QUARANTINE"]},
    "review":{
      "type":"object","required":["review_epoch","expires_at"],
      "properties":{
        "review_epoch":{"type":"integer","minimum":0},
        "expires_at":{"type":"string"},
        "reason_for_revalidation":{"type":"string"}
      }
    }
  },
  "allOf":[
    {
      "if":{"properties":{"assurance_level":{"enum":["I3","I4","I5"]}}},
      "then":{"properties":{"unknown_dependency_policy":{"enum":["BLOCK","HOLD","QUARANTINE"]}}}
    }
  ]
}
